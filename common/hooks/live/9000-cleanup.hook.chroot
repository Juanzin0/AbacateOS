#!/bin/sh
# Limpeza final: remove ferramentas de build e reduz o tamanho da imagem
set -e

apt-get purge -y git sassc 2>/dev/null || true
apt-get autoremove -y --purge 2>/dev/null || true
apt-get clean
rm -rf /var/lib/apt/lists/* /usr/share/doc/* /usr/share/man/* /usr/share/info/*
find /usr/share/locale -mindepth 1 -maxdepth 1 ! -name 'pt*' ! -name 'en*' ! -name 'locale.alias' -exec rm -rf {} + 2>/dev/null || true
